        </form>
    </div>
</div>

<script>
    let linkPagoVideo = "";

    function abrirModalVideollamada(nombrePlan, link) {
        linkPagoVideo = link;
        document.getElementById('modalVideollamada').style.display = 'flex';
    }

    function cerrarModalVideollamada() {
        document.getElementById('modalVideollamada').style.display = 'none';
    }

    function enviarWhatsAppYIrAlPago() {
        const nombre = document.getElementById('nombreVideo').value;
        const whatsapp = document.getElementById('whatsappVideo').value;
        const detalles = document.getElementById('detallesVideo').value;

        if(!nombre || !whatsapp) {
            alert("Por favor completa tu nombre y número de WhatsApp.");
            return;
        }

        // Mensaje preescrito específico para la videollamada 1v1
        let mensaje = `¡Hola Claudio! 📞 Quiero contratar la Videollamada Personalizada 1v1 ($90.000).\n\n` +
                      `👤 *Nombre:* ${nombre}\n` +
                      `📱 *WhatsApp:* ${whatsapp}\n` +
                      `🤝 *Forma de trabajo / Disponibilidad:* ${detalles || 'A coordinar'}`;

        const tuNumeroWhatsApp = "5492233448963";
        const urlWhatsApp = `https://api.whatsapp.com/send?phone=${tuNumeroWhatsApp}&text=${encodeURIComponent(mensaje)}`;

        // Abre WhatsApp con el mensaje listo para ti
        window.open(urlWhatsApp, '_blank');

        // Redirige al link de pago de Mercado Pago de $90.000
        setTimeout(function() {
            window.location.href = linkPagoVideo;
        }, 1000);
    }
</script>
