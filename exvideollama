        <form id="formVideo">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 11px; color: #d4af37; margin-bottom: 5px; font-weight: bold; text-transform: uppercase;">Nombre y Apellido</label>
                <input type="text" id="nombreVideo" placeholder="Tu nombre" required style="width: 100%; padding: 10px 12px; background-color: #121212; border: 1px solid #333; border-radius: 8px; color: #fff;">
            </div>

            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 11px; color: #d4af37; margin-bottom: 5px; font-weight: bold; text-transform: uppercase;">WhatsApp de contacto</label>
                <input type="tel" id="whatsappVideo" placeholder="Ej: 223..." required style="width: 100%; padding: 10px 12px; background-color: #121212; border: 1px solid #333; border-radius: 8px; color: #fff;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 11px; color: #d4af37; margin-bottom: 5px; font-weight: bold; text-transform: uppercase;">¿Cómo querés que organicemos el trabajo 1v1?</label>
                <textarea id="detallesVideo" placeholder="Ej: Disponibilidad horaria, objetivos específicos, días que preferís entrenar..." style="width: 100%; padding: 10px 12px; background-color: #121212; border: 1px solid #333; border-radius: 8px; color: #fff; height: 80px; resize: none;"></textarea>
            </div>

            <button type="button" onclick="enviarWhatsAppYIrAlPago()" style="width: 100%; background: linear-gradient(135deg, #0099ff 0%, #0077cc 100%); color: #ffffff; padding: 14px; border: none; border-radius: 8px; font-weight: bold; font-size: 15px; cursor: pointer;">
                🔒 Enviar datos y Pagar ($90.000)
