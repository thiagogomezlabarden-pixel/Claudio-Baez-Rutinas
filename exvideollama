    <div class="modal-card" style="background-color: #1a1a1a; max-width: 500px; width: 100%; padding: 30px; border-radius: 14px; border: 2px solid #d4af37; position: relative; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
        <button onclick="cerrarModalVideollamada()" style="position: absolute; top: 15px; right: 20px; background: none; border: none; color: #b0b0b0; font-size: 24px; cursor: pointer;">&times;</button>
        
